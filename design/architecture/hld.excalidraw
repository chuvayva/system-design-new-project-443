      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "oV82rpfbuoComHx-FQfiA",
        "iMNS6kVvD6ngbYM5xWMle"
      ],
      "frameId": null,
      "index": "b0V",
      "roundness": null,
      "seed": 1063019378,
      "version": 59,
      "versionNonce": 49676003,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1794812346603,
      "created": 1793091055893,
      "link": null,
      "locked": false,
      "text": "5. Rate Limit Ban &\nRebalance Storm:\nВоркеры отправляют\n8000 RPS в AML API с\nлимитом 300 RPS ->\nHTTP 429 Ban на 24\nчаса. Ожидание ответов\nпревышает\nmax.poll.interval.ms ->\nБесконечный Rebalance\nStorm в Kafka.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "yQOeuUuVaHBLM7_6SA7ks",
      "originalText": "5. Rate Limit Ban & Rebalance Storm: Воркеры отправляют 8000 RPS в AML API с лимитом 300 RPS -> HTTP 429 Ban на 24 часа. Ожидание ответов превышает max.poll.interval.ms -> Бесконечный Rebalance Storm в Kafka.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "kpzJSUQWnwa19gtEMeK7d",
      "type": "rectangle",
      "x": 256.2265625,
      "y": 1219.377402042997,
      "width": 260,
      "height": 450,
      "angle": 0,
      "strokeColor": "#333",
      "backgroundColor": "#FFA500",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "oV82rpfbuoComHx-FQfiA",
        "iMNS6kVvD6ngbYM5xWMle"
      ],
