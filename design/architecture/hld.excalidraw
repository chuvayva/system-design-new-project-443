      "link": null,
      "locked": false,
      "text": "5. Исходная проблема, 8 антипаттернов потоковой обработки и сценарии катастрофы",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": "3vHu1-lU2ec_MinSB_e0f",
      "originalText": "5. Исходная проблема, 8 антипаттернов потоковой обработки и сценарии катастрофы",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "BDBXiiyQqRJkkCGQzMdpr",
      "type": "rectangle",
      "x": -1651.2265625,
      "y": 1174.377402042997,
      "width": 260,
      "height": 540,
      "angle": 0,
      "strokeColor": "#333",
      "backgroundColor": "#FFA500",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "oV82rpfbuoComHx-FQfiA",
        "iMNS6kVvD6ngbYM5xWMle"
      ],
      "frameId": null,
      "index": "b0K",
      "roundness": null,
