    {
      "id": "bg_z8ktTMsdkSYqEs1yL1",
      "type": "text",
      "x": -40.183372497558594,
      "y": 1306.877402042997,
      "width": 232.8198699951172,
      "height": 275,
      "angle": 0,
      "strokeColor": "#000",
