      "locked": false
    },
    {
      "id": "_4Y1Llc8xvumZwnaNJznL",
      "type": "text",
      "x": 263.48665618896484,
      "y": 1306.877402042997,
      "width": 245.4798126220703,
      "height": 275,
      "angle": 0,
      "strokeColor": "#000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
