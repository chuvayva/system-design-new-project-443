      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "oV82rpfbuoComHx-FQfiA",
        "iMNS6kVvD6ngbYM5xWMle"
      ],
      "frameId": null,
      "index": "b0X",
      "roundness": null,
      "seed": 522956530,
      "version": 59,
      "versionNonce": 372910723,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1794812346603,
      "created": 1793091055893,
      "link": null,
      "locked": false,
      "text": "6. Processing Time vs\nEvent Time: Правила\nантифрода считаются по\nсистемным часам сервера\n(Processing Time). Пауза\nсети на мобильных\nклиентах приводит к\nприлету 20 транзакций\nза 1 секунду ->\nОшибочная блокировка\nза 'атаку ботнета'.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "kpzJSUQWnwa19gtEMeK7d",
      "originalText": "6. Processing Time vs Event Time: Правила антифрода считаются по системным часам сервера (Processing Time). Пауза сети на мобильных клиентах приводит к прилету 20 транзакций за 1 секунду -> Ошибочная блокировка за 'атаку ботнета'.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
